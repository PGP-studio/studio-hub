# Local development only. The Vite dev server adds this token to requests it
# proxies to GitHub, so it never reaches the browser. If it's empty, the dev
# server falls back to `gh auth token`.
# Needs scopes: repo, read:org, project.
GITHUB_TOKEN=

# Optional: read hub.config.json from this branch instead of the default branch.
VITE_HUB_CONFIG_REF=

# Sign-in (deployed app). Set in Vercel, not here:
#   VITE_GITHUB_CLIENT_ID  OAuth App client ID (public, baked into the page)
#   GITHUB_CLIENT_ID       optional; api/oauth.ts falls back to VITE_GITHUB_CLIENT_ID
#   GITHUB_CLIENT_SECRET   OAuth App client secret (Vercel only, never in a file)
# Setting VITE_GITHUB_CLIENT_ID locally turns on sign-in in `npm run dev` too.
