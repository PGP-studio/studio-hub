# Local development only. The Vite dev server adds this token to requests it
# proxies to GitHub, so it never reaches the browser. If it's empty, the dev
# server falls back to `gh auth token`.
# Needs scopes: repo, read:org, project.
GITHUB_TOKEN=

# Optional: read hub.config.json from this branch instead of the default branch.
VITE_HUB_CONFIG_REF=

# Sign-in (deployed app). Set in Vercel, not here (all three can be Sensitive):
#   GITHUB_CLIENT_ID      OAuth App client ID
#   GITHUB_CLIENT_SECRET  OAuth App client secret
#   HUB_CONFIG_REF        optional: branch to read hub.config.json from

# Sounds tab: ElevenLabs key. On Vercel set ELEVENLABS_API_KEY (Sensitive) in Production.
# Locally, without it, the dev server returns short fake beeps instead of real sounds.
ELEVENLABS_API_KEY=
